# ---------------------------------------------------------------------------
# ReValli: configuração da instalação. Copie para .env e ajuste.
# ---------------------------------------------------------------------------

# Senha do banco (obrigatória). Gere uma com: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Modo de acesso ----------------------------------------------------------
# Escolha UM dos blocos abaixo.

# 1) Rede local (padrão): http://IP-DO-SERVIDOR:8080
SITE_ADDRESS=:80
HTTP_PORT=8080
PUBLIC_URL=http://localhost:8080
COOKIE_SECURE=false

# 2) Túnel (Cloudflare Tunnel): suba com --profile tunnel.
#    No painel do túnel, aponte o domínio para http://web:80.
# SITE_ADDRESS=:80
# PUBLIC_URL=https://revalli.seudominio.org
# COOKIE_SECURE=true
# CLOUDFLARE_TUNNEL_TOKEN=

# 3) Público com domínio próprio e HTTPS automático (portas 80 e 443 abertas)
# SITE_ADDRESS=revalli.seudominio.org
# HTTP_PORT=80
# HTTPS_PORT=443
# PUBLIC_URL=https://revalli.seudominio.org
# COOKIE_SECURE=true

# --- Importação e metadados -----------------------------------------------------
# Completar resumos/DOIs faltantes consultando a API pública do OpenAlex.
# Desligue (false) se o servidor não tiver acesso à internet.
# ENRICHMENT_ENABLED=true
# Um e-mail de contato faz o OpenAlex atender com prioridade ("polite pool").
# ENRICHMENT_CONTACT_EMAIL=
# MAX_IMPORT_MB=50

# --- Busca direta nas bases e snowballing --------------------------------------
# Consulta PubMed, OpenAlex e Europe PMC pelas APIs públicas. Desligue (false) sem internet.
# O e-mail de contato acima também é enviado ao PubMed e ao OpenAlex.
# SEARCH_APIS_ENABLED=true
# Chave gratuita do NCBI (opcional): aumenta o limite do PubMed de 3 para 10 requisições/s.
# NCBI_API_KEY=
# Chave gratuita do OpenAlex (https://openalex.org/settings/api). Sem chave, o OpenAlex dá só um
# orçamento diário pequeno, dividido por todos na mesma rede, e a busca no SciELO e no PePSIC
# (que faz uma consulta por lote de revistas) gasta rápido. Com chave o limite é bem maior e as
# buscas com mais de 5 operadores AND/OR/NOT passam de 1 para 5 por segundo.
# OPENALEX_API_KEY=
# Máximo de registros trazidos por busca ou por snowballing.
# API_SEARCH_MAX=10000

# --- Texto completo -------------------------------------------------------------
# Tamanho máximo de cada PDF e de um ZIP com vários PDFs, em MB.
# Os arquivos ficam no volume de dados (revalli_data), em /data/files.
# MAX_PDF_MB=100
# MAX_ZIP_MB=2000

# --- IA (opcional) ------------------------------------------------------------
# Com --profile local-ai o Ollama roda dentro do compose (exige NVIDIA Container Toolkit).
# Os provedores e modelos são configurados na interface, em "IA".
# Chave usada para cifrar as chaves de API. Se ficar vazia, uma é gerada e guardada no
# volume de dados na primeira vez. Se definir, gere com: openssl rand -hex 32
# Trocar esta chave depois exige cadastrar as chaves de API de novo.
# SECRET_KEY=
# Contexto do Ollama (tokens). 16384 cabe numa GPU de 11 GB com um modelo de 8B em Q4.
# OLLAMA_CONTEXT_LENGTH=16384
# Quanto texto do PDF vai para a IA na extração de dados (cerca de 4 caracteres por token).
# AI_EXTRACT_MAX_CHARS=40000

# --- Backup (opcional, --profile backup) --------------------------------------
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=14

# --- Imagens -----------------------------------------------------------------
# REVALLI_IMAGE_PREFIX=ghcr.io/guivalli
# REVALLI_VERSION=latest

# --- Login único (OpenID Connect), opcional ---------------------------------------
# Endereço de retorno a cadastrar no provedor: PUBLIC_URL + /api/auth/oidc/callback
# OIDC_ISSUER=https://sso.exemplo.org/realms/laboratorio
# OIDC_CLIENT_ID=revalli
# OIDC_CLIENT_SECRET=
# OIDC_BUTTON_LABEL=Entrar com a conta do laboratório
# Cria a conta de quem entra pela primeira vez (nunca como administrador)
# OIDC_AUTO_CREATE=false
# Domínios de e-mail aceitos, separados por vírgula (vazio: qualquer um)
# OIDC_ALLOWED_DOMAINS=
